{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Write(./research/sources/**)",
      "Edit(./research/sources/**)",
      "Write(./artifacts/_registry.json)",
      "Edit(./artifacts/_registry.json)",
      "Write(./artifacts/ARTIFACTS.md)",
      "Edit(./artifacts/ARTIFACTS.md)",
      "Read(./.env)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)"
    ],
    "ask": [
      "Write(./design-system/component-index.json)",
      "Edit(./design-system/component-index.json)",
      "Write(./design-system/tokens/tokens.json)",
      "Edit(./design-system/tokens/tokens.json)",
      "Write(./CLAUDE.md)",
      "Edit(./CLAUDE.md)",
      "Write(./artifacts/_types.json)",
      "Edit(./artifacts/_types.json)",
      "Bash(rm:*)",
      "Bash(git push:*)"
    ],
    "allow": [
      "Read(./**)",
      "Grep(./**)",
      "Glob(./**)",
      "Bash(python3 ./.claude/hooks/*)",
      "Bash(python3 ./validation/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/gate-b.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-check.py\""
          }
        ]
      }
    ]
  }
}